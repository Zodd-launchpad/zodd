// Schema del ledger off-chain. Esto ES la "blockchain" de la plataforma:
// no hay contrato, esto es la fuente de verdad de quién tiene qué.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Cuenta interna ("wallet SHLD"). No es una wallet de Zcash real: es el
// login/identificador que agrupa las tenencias de tokens de un usuario.
model InternalWallet {
  id            String   @id @default(cuid())
  walletTag     String   @unique // ej. "5310f1ce", parte visible corta
  seedHashHex   String   // hash de las 12 palabras, nunca la frase en claro
  createdAt     DateTime @default(now())
  // Last real Zcash address used to receive a sell payout from this
  // wallet -- remembered so the Sell modal can pre-fill it instead of
  // asking the payer to paste it in again for every token (Brai,
  // 2026-09-07: "cuando toco SELL ya me queda asociada... asi no tengo
  // que pegar cada vez que voy a pagar un token diferente").
  defaultRefundAddress String?

  balances Balance[]
  orders   Order[]
}

// Brai, 2026-09-11: "quiero que puedas trabajar con Ycash y Zcash" -- each
// token trades in exactly ONE currency for its whole life (decided at
// creation, see Token.currency below), not a single curve that accepts
// either -- that was the explicit call over the alternative (one curve,
// pay-in-either-currency with live conversion). YEC starts in mock mode
// (see ycashMock.ts) until Brai stands up real Ycash node/wallet infra.
enum Currency {
  ZEC
  YEC
}

model Token {
  id                String   @id @default(cuid())
  symbol            String   @unique
  name              String
  totalSupply       BigInt   // ej. 1_000_000_000 * 10^decimals
  decimals          Int      @default(0)
  creatorWalletId   String
  genesisMemoTxid   String?  // txid shielded donde se inscribió name/symbol/supply
  createdAt         DateTime @default(now())
  // Brai, 2026-09-11: which chain this token's whole trading life happens
  // on. Defaults to ZEC so every token created before this field existed
  // is unaffected. Deliberately NOT renaming curveReserveZec and friends
  // below to something generic -- those columns hold real, live financial
  // data for existing tokens, and prisma db push --accept-data-loss would
  // happily drop-and-recreate a renamed column. They're kept ZEC-named but
  // are really "amount in whatever `currency` is" from here on -- the
  // bonding-curve math (bondingCurve.ts) and fee math (fees.ts) are pure
  // percentage/ratio functions that never cared which currency they were
  // fed, so nothing there needs to change.
  currency          Currency @default(ZEC)

  // Perfil del token (todo opcional, lo carga el creador al crearlo)
  logoDataUrl       String?  @db.Text // imagen como data URL (base64), ya redimensionada en el navegador
  description       String?  @db.Text
  twitterUrl        String?
  websiteUrl        String?

  // Estado de la bonding curve (ver lib/bondingCurve.ts para la matemática)
  curveReserveZec   Decimal  @db.Decimal(20, 8) // ZEC efectivo acumulado en la curva
  curveSoldTokens   BigInt   @default(0)        // tokens ya vendidos por la curva
  graduated         Boolean  @default(false)
  graduatedAt       DateTime?

  // Fee de trading (ver lib/fees.ts): 3% por operación, de los cuales 1
  // punto porcentual se acumula acá y se reparte al creador cada 24hs;
  // el resto queda en la wallet de la plataforma (solo se lleva la cuenta
  // acá para mostrar el total, no requiere un movimiento aparte).
  creatorPayoutAddress   String?   // dirección Zcash del creador (puesta al crear el token)
  creatorFeeAccruedZec   Decimal   @default(0) @db.Decimal(20, 8) // sin repartir todavía
  creatorFeeTotalPaidZec Decimal   @default(0) @db.Decimal(20, 8) // repartido históricamente
  platformFeeTotalZec    Decimal   @default(0) @db.Decimal(20, 8) // fee de plataforma acumulado (solo informativo)
  lastFeePayoutAt        DateTime? // último reparto al creador

  // Brai, 2026-09-07: "blanquea todos los tokens... que no se vean todos
  // esos tokens de prueba" -- pre-launch cleanup. NOT a delete: these test
  // tokens moved real ZEC (fees, sells), so wiping their rows would lose
  // that history from the financial audit (see getFinancialAudit in
  // store.ts). `hidden` just drops a token out of every public listing
  // (see listTokens) while its data -- and the real ZEC it's tied to --
  // stays exactly where it was. Reversible via the same admin route that
  // sets it.
  hidden      Boolean  @default(false)

  balances    Balance[]
  orders      Order[]
  pricePoints PricePoint[]
  feePayouts  CreatorFeePayout[]

  @@index([graduated])
  @@index([hidden])
}

// Historial de repartos de fee al creador (para mostrar transparencia:
// "se pagaron X ZEC hace Y horas"). Se corre cada ~15min y reparte a
// cualquier token con fee acumulado que no cobró en las últimas 24hs.
model CreatorFeePayout {
  id        String   @id @default(cuid())
  tokenId   String
  amountZec Decimal  @db.Decimal(20, 8)
  toAddress String
  txid      String?
  createdAt DateTime @default(now())

  token Token @relation(fields: [tokenId], references: [id])

  @@index([tokenId, createdAt])
}

// Brai, 2026-09-07: "los fee [de la plataforma], como claimeo" -- the
// platform's 1% cut was never paid out anywhere (see PLATFORM_FEE_BPS in
// fees.ts: "kept simply by never paying it out"), so it just sits inside
// the platform's real Zcash wallet balance forever. Token.platformFeeTotalZec
// is a lifetime, never-decremented running total (explicitly "solo
// informativo" -- not safe to withdraw against directly, since most of
// the wallet's balance is actually the bonding-curve reserve owed to
// future sellers, not "free" platform money). This table is the ledger of
// what's actually been withdrawn, so the claimable amount can be computed
// as sum(Token.platformFeeTotalZec) - sum(PlatformWithdrawal.amountZec) --
// see getPlatformFeeStatus / recordPlatformWithdrawal in store.ts and the
// admin routes in server.ts. Not tied to a single token (it's the
// platform-wide cut), so no tokenId here, unlike CreatorFeePayout above.
model PlatformWithdrawal {
  id        String   @id @default(cuid())
  amountZec Decimal  @db.Decimal(20, 8)
  toAddress String
  txid      String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// One row per trade (and one at token creation), so the chart has real
// history to draw instead of only the latest curve state.
model PricePoint {
  id        String   @id @default(cuid())
  tokenId   String
  priceZec  Decimal  @db.Decimal(30, 18)
  mcapZec   Decimal  @db.Decimal(20, 8)
  createdAt DateTime @default(now())

  token Token @relation(fields: [tokenId], references: [id])

  @@index([tokenId, createdAt])
}

model Balance {
  id               String   @id @default(cuid())
  internalWalletId String
  tokenId          String
  amount           BigInt   @default(0)

  internalWallet InternalWallet @relation(fields: [internalWalletId], references: [id])
  token          Token          @relation(fields: [tokenId], references: [id])

  @@unique([internalWalletId, tokenId])
}

enum TokenCreationStatus {
  PENDING // esperando que el creador mande el fee a zecAddress
  CREATED // pago detectado, el Token ya existe (resultTokenId)
  EXPIRED
  FAILED
}

// Un token reservado pero todavía no real: igual que SHLD.fun, el creador
// tiene que pagar el fee de creación DESDE SU PROPIA wallet a una dirección
// de un solo uso (mismo mecanismo que una orden de compra) antes de que el
// Token exista de verdad. "No wallet connect needed to create" -- el pago
// en sí es la prueba. Antes de este cambio (2026-09-06) la plataforma se
// pagaba a sí misma, lo cual era un error de concepto: no era el creador
// quien pagaba, y no tenía sentido pedirle plata a la wallet de la
// plataforma cada vez que alguien creaba un token de prueba.
model PendingTokenCreation {
  id                   String              @id @default(cuid())
  symbol               String
  name                 String
  totalSupply          BigInt
  creatorWalletId      String
  // Which currency the creator is paying the create fee (+ optional first
  // buy) in -- becomes the resulting Token's currency, see the comment on
  // Token.currency above.
  currency             Currency            @default(ZEC)
  creatorPayoutAddress String?
  logoDataUrl          String?             @db.Text
  description          String?             @db.Text
  twitterUrl           String?
  websiteUrl           String?
  zecAddress           String?
  // ZODD (2026-09-08): the diversifier (ZIP 32 `d`) of zecAddress itself,
  // one per shielded pool it advertises. This is the real per-order match
  // key -- a patched zingo-cli now returns it in the same call that mints
  // zecAddress, and reports it back on every incoming note, so a payment
  // can be attributed to this exact address with zero memo and zero
  // amount-uniqueness requirement (see zcash-wallet-service's
  // zingolib-patches/ and the long comment on the poll loop in
  // backend/src/lib/zcashReal.ts). Nullable: an in-flight order created
  // before this column existed, or created against an unpatched
  // zingo-cli, simply has none -- the poll loop falls back to the older
  // memo/amount matching passes for those, unchanged.
  zecSaplingDiversifierHex String?
  zecOrchardDiversifierHex String?
  expectedZecAmount    Decimal             @db.Decimal(20, 8)
  // Brai, 2026-09-08: "que puedas hacer una first buy" -- an optional
  // creator buy bundled into the SAME payment as the create fee (one send
  // covers both). expectedZecAmount above is the TOTAL of the two;
  // firstBuyZec is just the buy portion, kept separately so the payment
  // handler in server.ts knows how much of the confirmed payment to run
  // through the bonding curve once the token exists. 0 (the default) means
  // no bundled buy -- exactly today's behavior.
  firstBuyZec          Decimal             @default(0) @db.Decimal(20, 8)
  status               TokenCreationStatus @default(PENDING)
  resultTokenId        String?
  createdAt            DateTime            @default(now())
  completedAt          DateTime?

  @@index([status])
  @@index([zecAddress])
}

enum OrderSide {
  BUY
  SELL
}

enum OrderStatus {
  PENDING   // esperando pago (BUY) o esperando payout (SELL)
  FILLED
  EXPIRED
  FAILED
}

// Una orden = una dirección Zcash de un solo uso (BUY) o un payout (SELL).
// La dirección ES la orden, tal cual el modelo de SHLD.fun.
model Order {
  id                String      @id @default(cuid())
  internalWalletId  String
  tokenId           String
  side              OrderSide
  status            OrderStatus @default(PENDING)
  // Brai, 2026-09-11: denormalized copy of the parent Token's currency at
  // the time this order was placed -- lets server.ts pick the right wallet
  // service (walletServiceFor) for this order without a join on every
  // payment/resume-watch lookup. Defaults ZEC so every pre-existing order
  // is unaffected.
  currency          Currency    @default(ZEC)

  zecAddress        String?     // dirección diversificada generada para esta orden (BUY)
  // Diversifier (ZIP 32 `d`) de zecAddress, uno por pool shielded -- ver el
  // comentario largo en el mismo campo de PendingTokenCreation más arriba.
  zecSaplingDiversifierHex String?
  zecOrchardDiversifierHex String?
  refundAddress     String?     // dirección del usuario para el payout (SELL, o refund de sobrepago)
  zecAmount         Decimal?    @db.Decimal(20, 8) // monto pagado/pagado-de-vuelta, confirmado on-chain
  tokenAmount       BigInt?     // tokens acreditados/debitados, calculado a precio de ejecución
  executionTxid     String?     // txid shielded que llenó la orden

  createdAt         DateTime    @default(now())
  filledAt          DateTime?

  internalWallet InternalWallet @relation(fields: [internalWalletId], references: [id])
  token          Token          @relation(fields: [tokenId], references: [id])

  @@index([status])
  @@index([zecAddress])
}
