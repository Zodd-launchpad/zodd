// Schema del ledger off-chain. Esto ES la "blockchain" de la plataforma:
// no hay contrato, esto es la fuente de verdad de quién tiene qué.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Cuenta interna ("wallet SHLD"). No es una wallet de Zcash real: es el
// login/identificador que agrupa las tenencias de tokens de un usuario.
model InternalWallet {
  id            String   @id @default(cuid())
  walletTag     String   @unique // ej. "5310f1ce", parte visible corta
  // hash de las 12 palabras, nunca la frase en claro. Null para una wallet
  // conectada por Noir (ver noirAddress abajo): esa wallet no tiene frase
  // de 12 palabras en absoluto, su "login" es la extension misma.
  seedHashHex   String?
  createdAt     DateTime @default(now())
  // Last real Zcash address used to receive a sell payout from this
  // wallet -- remembered so the Sell modal can pre-fill it instead of
  // asking the payer to paste it in again for every token (Brai,
  // 2026-09-07: "cuando toco SELL ya me queda asociada... asi no tengo
  // que pegar cada vez que voy a pagar un token diferente"). Para una
  // wallet conectada por Noir, esto se llena automaticamente con la
  // direccion shielded que devuelve zcash.connect() -- ver noirAddress.
  defaultRefundAddress String?

  // Brai, 2026-09-18: "cuando conectas la wallet no creas una wallet con 10
  // palabras sino que conectas la extension de la wallet NOIR para
  // navegador y ya te asocia tu wallet ... eso tenemos que integrar a la
  // pagina" -- segunda forma de "iniciar sesion" ademas de crear/importar
  // por 12 palabras: conectar la extension del navegador Noir Wallet
  // (@noir-wallet/sdk). Guardamos la direccion TRANSPARENTE (no la
  // shielded) porque es la que Noir puede firmar mensajes con
  // zcash.signMessage() -- ver POST /api/wallets/connect-noir en
  // server.ts, que verifica esa firma contra un challenge de un solo uso
  // (NoirAuthChallenge) antes de crear o reconocer esta wallet. Esto es lo
  // que hace que reconectar la MISMA extension en otra sesion/dispositivo
  // te devuelva la MISMA InternalWallet en vez de crear una nueva cada vez.
  noirAddress   String?  @unique

  balances Balance[]
  orders   Order[]
  // Brai, 2026-09-18: "necesito habilitar el mercado NFT" -- same idea as
  // balances/orders above but for NFT pieces (see NftItem and friends
  // below). A wallet owns zero or more NftItem rows directly (no
  // Balance-style amount -- each NFT is 1-of-1, not fungible).
  nftItems             NftItem[]          @relation("NftOwner")
  nftMints             PendingNftMint[]
  nftPurchasesAsBuyer  NftPurchaseOrder[] @relation("NftBuyer")
  nftPurchasesAsSeller NftPurchaseOrder[] @relation("NftSeller")
}

// Brai, 2026-09-11: "quiero que puedas trabajar con Ycash y Zcash" -- each
// token trades in exactly ONE currency for its whole life (decided at
// creation, see Token.currency below), not a single curve that accepts
// either -- that was the explicit call over the alternative (one curve,
// pay-in-either-currency with live conversion). YEC starts in mock mode
// (see ycashMock.ts) until Brai stands up real Ycash node/wallet infra.
enum Currency {
  ZEC
  YEC
}

model Token {
  id                String   @id @default(cuid())
  symbol            String   @unique
  name              String
  totalSupply       BigInt   // ej. 1_000_000_000 * 10^decimals
  decimals          Int      @default(0)
  creatorWalletId   String
  genesisMemoTxid   String?  // txid shielded donde se inscribió name/symbol/supply
  createdAt         DateTime @default(now())
  // Brai, 2026-09-11: which chain this token's whole trading life happens
  // on. Defaults to ZEC so every token created before this field existed
  // is unaffected. Deliberately NOT renaming curveReserveZec and friends
  // below to something generic -- those columns hold real, live financial
  // data for existing tokens, and prisma db push --accept-data-loss would
  // happily drop-and-recreate a renamed column. They're kept ZEC-named but
  // are really "amount in whatever `currency` is" from here on -- the
  // bonding-curve math (bondingCurve.ts) and fee math (fees.ts) are pure
  // percentage/ratio functions that never cared which currency they were
  // fed, so nothing there needs to change.
  currency          Currency @default(ZEC)

  // Perfil del token (todo opcional, lo carga el creador al crearlo)
  logoDataUrl       String?  @db.Text // imagen como data URL (base64), ya redimensionada en el navegador
  description       String?  @db.Text
  twitterUrl        String?
  websiteUrl        String?

  // Estado de la bonding curve (ver lib/bondingCurve.ts para la matemática)
  curveReserveZec   Decimal  @db.Decimal(20, 8) // ZEC efectivo acumulado en la curva
  curveSoldTokens   BigInt   @default(0)        // tokens ya vendidos por la curva
  graduated         Boolean  @default(false)
  graduatedAt       DateTime?
  // Brai, 2026-09-19: "LA PIRAMIDE... estos tokens, tienen una curva que a
  // los 3 ZEC bondean, luego pasan al general" -- un token de la pirámide
  // (solo creable teniendo 1 reliquia, ver walletOwnsReliquia) gradúa a los
  // 3 ZEC en vez de los DEFAULT_CURVE_CONFIG.graduationZecThreshold
  // normales; null = usa el default de siempre (todo token no-pirámide).
  // La forma de la curva (precio, virtualZecReserves/virtualTokenReserves)
  // no cambia -- solo este umbral, ver graduationThresholdFor en store.ts.
  graduationZecThresholdOverride Decimal? @db.Decimal(20, 8)
  isPyramidToken                 Boolean  @default(false)

  // Fee de trading (ver lib/fees.ts): 3% por operación, de los cuales 1
  // punto porcentual se acumula acá y se reparte al creador cada 24hs;
  // el resto queda en la wallet de la plataforma (solo se lleva la cuenta
  // acá para mostrar el total, no requiere un movimiento aparte).
  creatorPayoutAddress   String?   // dirección Zcash del creador (puesta al crear el token)
  creatorFeeAccruedZec   Decimal   @default(0) @db.Decimal(20, 8) // sin repartir todavía
  creatorFeeTotalPaidZec Decimal   @default(0) @db.Decimal(20, 8) // repartido históricamente
  platformFeeTotalZec    Decimal   @default(0) @db.Decimal(20, 8) // fee de plataforma acumulado (solo informativo)
  lastFeePayoutAt        DateTime? // último reparto al creador

  // Brai, 2026-09-07: "blanquea todos los tokens... que no se vean todos
  // esos tokens de prueba" -- pre-launch cleanup. NOT a delete: these test
  // tokens moved real ZEC (fees, sells), so wiping their rows would lose
  // that history from the financial audit (see getFinancialAudit in
  // store.ts). `hidden` just drops a token out of every public listing
  // (see listTokens) while its data -- and the real ZEC it's tied to --
  // stays exactly where it was. Reversible via the same admin route that
  // sets it.
  hidden      Boolean  @default(false)

  balances    Balance[]
  orders      Order[]
  pricePoints PricePoint[]
  feePayouts  CreatorFeePayout[]

  @@index([graduated])
  @@index([hidden])
}

// Historial de repartos de fee al creador (para mostrar transparencia:
// "se pagaron X ZEC hace Y horas"). Se corre cada ~15min y reparte a
// cualquier token con fee acumulado que no cobró en las últimas 24hs.
model CreatorFeePayout {
  id        String   @id @default(cuid())
  tokenId   String
  amountZec Decimal  @db.Decimal(20, 8)
  toAddress String
  txid      String?
  createdAt DateTime @default(now())

  token Token @relation(fields: [tokenId], references: [id])

  @@index([tokenId, createdAt])
}

// Brai, 2026-09-07: "los fee [de la plataforma], como claimeo" -- the
// platform's 1% cut was never paid out anywhere (see PLATFORM_FEE_BPS in
// fees.ts: "kept simply by never paying it out"), so it just sits inside
// the platform's real Zcash wallet balance forever. Token.platformFeeTotalZec
// is a lifetime, never-decremented running total (explicitly "solo
// informativo" -- not safe to withdraw against directly, since most of
// the wallet's balance is actually the bonding-curve reserve owed to
// future sellers, not "free" platform money). This table is the ledger of
// what's actually been withdrawn, so the claimable amount can be computed
// as sum(Token.platformFeeTotalZec) - sum(PlatformWithdrawal.amountZec) --
// see getPlatformFeeStatus / recordPlatformWithdrawal in store.ts and the
// admin routes in server.ts. Not tied to a single token (it's the
// platform-wide cut), so no tokenId here, unlike CreatorFeePayout above.
model PlatformWithdrawal {
  id        String   @id @default(cuid())
  amountZec Decimal  @db.Decimal(20, 8)
  toAddress String
  txid      String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// One row per trade (and one at token creation), so the chart has real
// history to draw instead of only the latest curve state.
model PricePoint {
  id        String   @id @default(cuid())
  tokenId   String
  priceZec  Decimal  @db.Decimal(30, 18)
  mcapZec   Decimal  @db.Decimal(20, 8)
  createdAt DateTime @default(now())

  token Token @relation(fields: [tokenId], references: [id])

  @@index([tokenId, createdAt])
}

model Balance {
  id               String   @id @default(cuid())
  internalWalletId String
  tokenId          String
  amount           BigInt   @default(0)

  internalWallet InternalWallet @relation(fields: [internalWalletId], references: [id])
  token          Token          @relation(fields: [tokenId], references: [id])

  @@unique([internalWalletId, tokenId])
}

enum TokenCreationStatus {
  PENDING // esperando que el creador mande el fee a zecAddress
  CREATED // pago detectado, el Token ya existe (resultTokenId)
  EXPIRED
  FAILED
}

// Un token reservado pero todavía no real: igual que SHLD.fun, el creador
// tiene que pagar el fee de creación DESDE SU PROPIA wallet a una dirección
// de un solo uso (mismo mecanismo que una orden de compra) antes de que el
// Token exista de verdad. "No wallet connect needed to create" -- el pago
// en sí es la prueba. Antes de este cambio (2026-09-06) la plataforma se
// pagaba a sí misma, lo cual era un error de concepto: no era el creador
// quien pagaba, y no tenía sentido pedirle plata a la wallet de la
// plataforma cada vez que alguien creaba un token de prueba.
model PendingTokenCreation {
  id                   String              @id @default(cuid())
  symbol               String
  name                 String
  totalSupply          BigInt
  creatorWalletId      String
  // Which currency the creator is paying the create fee (+ optional first
  // buy) in -- becomes the resulting Token's currency, see the comment on
  // Token.currency above.
  currency             Currency            @default(ZEC)
  creatorPayoutAddress String?
  logoDataUrl          String?             @db.Text
  description          String?             @db.Text
  twitterUrl           String?
  websiteUrl           String?
  zecAddress           String?
  // ZODD (2026-09-08): the diversifier (ZIP 32 `d`) of zecAddress itself,
  // one per shielded pool it advertises. This is the real per-order match
  // key -- a patched zingo-cli now returns it in the same call that mints
  // zecAddress, and reports it back on every incoming note, so a payment
  // can be attributed to this exact address with zero memo and zero
  // amount-uniqueness requirement (see zcash-wallet-service's
  // zingolib-patches/ and the long comment on the poll loop in
  // backend/src/lib/zcashReal.ts). Nullable: an in-flight order created
  // before this column existed, or created against an unpatched
  // zingo-cli, simply has none -- the poll loop falls back to the older
  // memo/amount matching passes for those, unchanged.
  zecSaplingDiversifierHex String?
  zecOrchardDiversifierHex String?
  expectedZecAmount    Decimal             @db.Decimal(20, 8)
  // Brai, 2026-09-08: "que puedas hacer una first buy" -- an optional
  // creator buy bundled into the SAME payment as the create fee (one send
  // covers both). expectedZecAmount above is the TOTAL of the two;
  // firstBuyZec is just the buy portion, kept separately so the payment
  // handler in server.ts knows how much of the confirmed payment to run
  // through the bonding curve once the token exists. 0 (the default) means
  // no bundled buy -- exactly today's behavior.
  firstBuyZec          Decimal             @default(0) @db.Decimal(20, 8)
  // Brai, 2026-09-19: "LA PIRAMIDE" -- reservado al momento del POST
  // /api/tokens (donde ya se verificó walletOwnsReliquia), sobrevive la
  // espera del pago, y completePendingTokenCreation lo usa para marcar el
  // Token resultante como isPyramidToken con graduationZecThresholdOverride
  // = 3 en vez del default normal.
  isPyramidToken       Boolean             @default(false)
  status               TokenCreationStatus @default(PENDING)
  resultTokenId        String?
  createdAt            DateTime            @default(now())
  completedAt          DateTime?

  @@index([status])
  @@index([zecAddress])
}

enum OrderSide {
  BUY
  SELL
}

enum OrderStatus {
  PENDING   // esperando pago (BUY) o esperando payout (SELL)
  FILLED
  EXPIRED
  FAILED
}

// Una orden = una dirección Zcash de un solo uso (BUY) o un payout (SELL).
// La dirección ES la orden, tal cual el modelo de SHLD.fun.
model Order {
  id                String      @id @default(cuid())
  internalWalletId  String
  tokenId           String
  side              OrderSide
  status            OrderStatus @default(PENDING)
  // Brai, 2026-09-11: denormalized copy of the parent Token's currency at
  // the time this order was placed -- lets server.ts pick the right wallet
  // service (walletServiceFor) for this order without a join on every
  // payment/resume-watch lookup. Defaults ZEC so every pre-existing order
  // is unaffected.
  currency          Currency    @default(ZEC)

  zecAddress        String?     // dirección diversificada generada para esta orden (BUY)
  // Diversifier (ZIP 32 `d`) de zecAddress, uno por pool shielded -- ver el
  // comentario largo en el mismo campo de PendingTokenCreation más arriba.
  zecSaplingDiversifierHex String?
  zecOrchardDiversifierHex String?
  refundAddress     String?     // dirección del usuario para el payout (SELL, o refund de sobrepago)
  zecAmount         Decimal?    @db.Decimal(20, 8) // monto pagado/pagado-de-vuelta, confirmado on-chain
  tokenAmount       BigInt?     // tokens acreditados/debitados, calculado a precio de ejecución
  executionTxid     String?     // txid shielded que llenó la orden

  createdAt         DateTime    @default(now())
  filledAt          DateTime?

  internalWallet InternalWallet @relation(fields: [internalWalletId], references: [id])
  token          Token          @relation(fields: [tokenId], references: [id])

  @@index([status])
  @@index([zecAddress])
}

// ---------- NFT marketplace ----------
// Brai, 2026-09-18: "necesito habilitar el mercado NFT... la idea es que
// cada wallet envie y pague nfts, los nfts quedan como si fueran tokens
// nomas que son nfts, fotitos que quedan en cada wallet en su perfil,
// donde pueden LISTAR o no listar" -- reference to copy: zecbit.net
// (collection/zecbit-genesis). Same off-chain-ledger philosophy as
// Token/Order above (no smart contract -- this table IS the source of
// truth for who owns which piece), reusing the exact same real-ZEC payment
// machinery (generateOrderAddress/onPaymentDetected/sendPayout in
// zcashReal.ts / zcashMock.ts / ycashMock.ts) that already moves money for
// token creation and buy/sell orders. No "make offer" (Brai: "obviemos la
// parte de que la gente pueda ofertar asi no la complicamos, solo listar,
// comprar y vender").
//
// Lives behind /nft on the frontend, deliberately unlinked from the main
// nav/homepage while this is being built (see HeaderBar.tsx/page.tsx) --
// Brai, 2026-09-18: "podemos trabajar estos cambios sobre la otra pagina,
// no la principal de zodd.fun, asi la gente no ve lo que estamos haciendo".

enum NftMintStatus {
  PENDING // esperando que el minter mande el pago a zecAddress
  CREATED // pago detectado, se le asignó una pieza al azar (resultItemId)
  EXPIRED
  FAILED
}

enum NftOrderStatus {
  PENDING // esperando que el comprador pague el precio listado
  FILLED
  EXPIRED
  FAILED
}

// Brai, 2026-09-18: "por ahora haya solo una unica coleccion que voy a
// hacer" -- el modelo soporta más de una a futuro, pero hoy solo existe
// (o no) esta primera. totalSupply/mintPriceZec son placeholders: "todavia
// no tengo la cantidad ni el numero y precio, arranca y deja todo en X" --
// no hay ninguna fila de esta tabla todavía; seedNftCollection.ts es lo
// que la va a crear (junto con sus NftItem) una vez que Brai mande el
// arte y los números reales. Hasta entonces /api/nft/* devuelve "not
// configured", nada es minteable con números inventados.
model NftCollection {
  id                String   @id @default(cuid())
  slug              String   @unique // parte de la URL, ej. "zodd-genesis"
  name              String
  description       String?  @db.Text
  currency          Currency @default(ZEC)
  totalSupply       Int // cantidad total de piezas -- X, TODO(Brai): número real
  mintPriceZec      Decimal  @db.Decimal(20, 8) // precio fijo de mint -- X, TODO(Brai): número real
  coverImageDataUrl String?  @db.Text
  // Brai, 2026-09-19: "hace 5555 de supply con las 3 fotos que te di, uno
  // que sea tier 1, el otro tier 2 y el otro tier 3" -- one shared image
  // per tier instead of a unique image per piece (5555 rows would mean
  // 5555 copies of the same 3 images otherwise). NftItem.imageDataUrl stays
  // as a per-piece override (null for every pool-seeded piece); resolved at
  // read time by toNftItemView/getCollectionTierImages in store.ts.
  papiroImageDataUrl    String? @db.Text
  fragmentoImageDataUrl String? @db.Text
  reliquiaImageDataUrl  String? @db.Text
  // Igual que Token.hidden: reservado para cuando exista un índice público
  // de colecciones (hoy hay una sola, alcanzada directo por slug, así que
  // esto todavía no filtra nada en las rutas -- ver server.ts).
  hidden            Boolean  @default(true)
  mintedCount       Int      @default(0) // contador denormalizado, evita un COUNT(*) en cada lectura
  createdAt         DateTime @default(now())

  // Brai, 2026-09-19: "la whitelist le activa en cierto horario y la
  // publica a partir de cierto horario" -- two presale gates, both
  // optional (null = that phase hasn't been scheduled yet). Read together
  // at mint time (see mintPhaseAt in store.ts): before whitelistStartsAt
  // nobody but an owner wallet can mint; from whitelistStartsAt up to
  // publicStartsAt only APPROVED whitelist wallets (NftWhitelistEntry) can;
  // from publicStartsAt on, anyone can. Set/updated via
  // POST /api/admin/nft-collection-schedule (ADMIN_TOKEN-gated) instead of
  // needing a redeploy every time the schedule changes.
  whitelistStartsAt DateTime?
  publicStartsAt    DateTime?

  items NftItem[]
  mints PendingNftMint[]

  @@index([hidden])
}

// Una fila por pieza, todas sembradas de una sola vez para todo el
// totalSupply (ver seedNftCollection.ts) con ownerInternalWalletId null --
// "todavía no minteada, en poder del pool de la colección". Mintear
// (PendingNftMint abajo) solo le asigna al azar una fila YA EXISTENTE a
// quien pagó; nunca crea filas al vuelo, así que "cuántas quedan" es un
// COUNT plano.
// Brai, 2026-09-19: "habra 3 tipos de nfts.. los papiros, los fragmentos y
// las reliquias" -- la forja (ver forgeCraft en store.ts): 5 PAPIRO ->
// 1 FRAGMENTO, 3 FRAGMENTO -> 1 RELIQUIA. Al principio (v14) toda pieza del
// pool nacia PAPIRO y FRAGMENTO/RELIQUIA solo salian de craftear. Desde
// "hace 5555 de supply... 60% tier1, 35% tier2, 5% tier3" (ver
// seedTieredNftCollection en store.ts) el pool sembrado YA trae piezas de
// los 3 tiers de entrada -- craftear sigue siendo la única otra forma de
// conseguir FRAGMENTO/RELIQUIA además del mint directo, no la única.
enum NftTier {
  PAPIRO
  FRAGMENTO
  RELIQUIA
}

model NftItem {
  id             String    @id @default(cuid())
  collectionId   String
  // Brai, 2026-09-19: "todos sigan un numero tipo TIER 1 #1321... si puede
  // empezar en 1300" -- editionNumber is now scoped PER TIER, not global:
  // each tier (PAPIRO/FRAGMENTO/RELIQUIA) has its own counter starting at
  // NFT_TIER_NUMBERING_START (see fees.ts), so "TIER 1 #1321" and
  // "TIER 2 #1321" can both exist -- that's why the unique constraint below
  // is now (collectionId, tier, editionNumber) instead of just
  // (collectionId, editionNumber). Forged pieces (ver forgeCraft) continue
  // their target tier's own counter, not a global one.
  editionNumber  Int
  name           String? // ej. "ZODD #61" -- opcional, si falta se muestra "#<editionNumber>"
  imageDataUrl   String?   @db.Text
  traits         Json? // mapa opcional {trait: valor}, se muestra en la página del item si existe
  mintedAt       DateTime?
  mintPaymentTxid String? // txid real que pagó el mint, o "FORGED" si esta pieza nació de un crafteo en la forja (ver forgeCraft)

  tier NftTier @default(PAPIRO)
  // Brai, 2026-09-19: "los papiros... podes crear 1 fragmento" -- crafteo
  // consume (quema) N piezas del tier inferior para crear 1 del tier
  // superior. Una pieza quemada nunca se borra (mismo espíritu que
  // Token.hidden: se conserva el historial) -- simplemente queda excluida
  // de todo lo demás (inventario del dueño, listado del mercado, conteos)
  // por tener burnedAt no-null. Ver forgeCraft en store.ts.
  burnedAt DateTime?

  ownerInternalWalletId String? // null = todavía no minteada

  // Listing del mercado secundario -- precio null = no listada. No hay una
  // tabla "Listing" aparte: como mucho hay un listing activo por pieza, así
  // que son campos directos del item (Brai: "pueden LISTAR o no listar",
  // sin ofertas).
  listedPriceZec Decimal? @db.Decimal(20, 8)
  listedAt       DateTime?
  // A dónde va la plata de una venta -- se toma al momento de listar
  // (igual que Token.creatorPayoutAddress), no se reusa
  // InternalWallet.defaultRefundAddress, así un listing siempre paga a la
  // dirección que su dueño quiso decir cuando listó, aunque después cambie
  // su dirección por defecto en otro lado.
  listedPayoutAddress String?

  collection          NftCollection      @relation(fields: [collectionId], references: [id])
  ownerInternalWallet InternalWallet?    @relation("NftOwner", fields: [ownerInternalWalletId], references: [id])
  purchases           NftPurchaseOrder[]

  @@unique([collectionId, tier, editionNumber])
  @@index([collectionId, ownerInternalWalletId])
  @@index([collectionId, listedPriceZec])
  @@index([ownerInternalWalletId, tier, burnedAt])
}

// Mismo mecanismo que PendingTokenCreation: se paga una dirección real de
// un solo uso, y el mint recién sucede de verdad cuando ese pago se
// detecta (ver el handler de pagos en server.ts). resultItemId se elige AL
// AZAR entre las NftItem sin mintear de esta colección en ese momento
// (claim atómico -- ver claimRandomUnmintedNftItem en store.ts).
model PendingNftMint {
  id                       String        @id @default(cuid())
  collectionId             String
  internalWalletId         String
  currency                 Currency      @default(ZEC)
  zecAddress               String?
  zecSaplingDiversifierHex String?
  zecOrchardDiversifierHex String?
  expectedZecAmount        Decimal       @db.Decimal(20, 8)
  status                   NftMintStatus @default(PENDING)
  resultItemId             String?
  createdAt                DateTime      @default(now())
  completedAt              DateTime?

  // Brai, 2026-09-19: "la posibilidad de subir la cantidad de nfts a
  // mintear" -- one payment can now cover several pieces at once.
  // expectedZecAmount is already quantity * unit price (computed by the
  // caller before generating the address); on payment, completePendingNftMint
  // claims `quantity` random pieces instead of always 1.
  quantity      Int      @default(1)
  // Every piece this payment claimed -- resultItemId keeps holding the
  // first one (unchanged shape for anything still reading it directly),
  // resultItemIds holds the full set for quantity > 1.
  resultItemIds String[] @default([])

  // Brai, 2026-09-19: "inclusive los que hacen free mint tienen que hacer
  // una tx con su wallet y cobrarle muy poco ... que cubran la transaccion
  // y un poquito mas" -- a whitelist free claim is no longer instant, it
  // goes through this exact same address/QR/poll payment flow, just for
  // NFT_FREE_MINT_FEE_ZEC (see fees.ts) instead of the real mint price. Set
  // only on that kind of row; a normal paid mint leaves it null. On
  // completion (completePendingNftMint), a non-null value here also
  // increments that NftWhitelistEntry's claimedCount/claimedAt -- loose
  // string reference on purpose, no FK, same "informational, not a join
  // obligation" pattern as NftWhitelistEntry.claimedByWalletId below.
  freeClaimWhitelistEntryId String?

  collection     NftCollection  @relation(fields: [collectionId], references: [id])
  internalWallet InternalWallet @relation(fields: [internalWalletId], references: [id])

  @@index([status])
  @@index([zecAddress])
}

// Comprar una pieza LISTADA en el mercado secundario -- mismo mecanismo de
// dirección-por-orden que un Order de compra de token, pero el payout va
// al DUEÑO ACTUAL, no a la plataforma (la plataforma solo hace de relay:
// el comprador paga a una dirección real de un solo uso de la plataforma,
// y al detectarse el pago la plataforma le manda un sendPayout real al
// vendedor -- ver handleNftPurchasePayment en server.ts). Sin "make offer"
// (Brai: "obviemos la parte de que la gente pueda ofertar"): el comprador
// siempre paga exactamente el precio listado. Brai, 2026-09-19: "el 1% de
// toda compra y venta de nft es para la plataforma" -- el 1% (ver
// splitNftFee/NFT_PLATFORM_FEE_BPS en fees.ts) sale del lado del vendedor,
// no se le suma al comprador; el resto (menos el fee de red real, ver
// NETWORK_FEE_ZEC en fees.ts) le llega al vendedor.
model NftPurchaseOrder {
  id                       String         @id @default(cuid())
  itemId                   String
  buyerInternalWalletId    String
  sellerInternalWalletId   String
  currency                 Currency       @default(ZEC)
  zecAddress               String?
  zecSaplingDiversifierHex String?
  zecOrchardDiversifierHex String?
  // Dirección del vendedor al momento en que se abrió esta compra --
  // copiada de NftItem.listedPayoutAddress, no leída de nuevo al llenarse
  // (si el vendedor deslistó/relistó mientras tanto, esta compra sigue
  // pagando a donde el vendedor dijo cuando el comprador la inició).
  payoutAddress            String
  expectedZecAmount        Decimal        @db.Decimal(20, 8)
  status                   NftOrderStatus @default(PENDING)
  executionTxid            String?
  createdAt                DateTime       @default(now())
  filledAt                 DateTime?
  // El 1% de la plataforma sobre esta venta (ver splitNftFee en fees.ts),
  // seteado recien cuando esto pasa a FILLED. Nunca se transfiere por
  // separado -- igual que el platformFee de los trades de tokens, queda
  // retenido simplemente por no formar parte de lo que se le paga al
  // vendedor (ver computeSellerPayout en handleNftPurchasePayment).
  // Sumado dentro de getPlatformFeeStatus junto a Token.platformFeeTotalZec
  // para que sea retirable por el flujo ya existente de
  // /api/admin/withdraw-platform-fee.
  platformFeeZec           Decimal?       @db.Decimal(20, 8)

  item                 NftItem        @relation(fields: [itemId], references: [id])
  buyerInternalWallet  InternalWallet @relation("NftBuyer", fields: [buyerInternalWalletId], references: [id])
  sellerInternalWallet InternalWallet @relation("NftSeller", fields: [sellerInternalWalletId], references: [id])

  @@index([status])
  @@index([zecAddress])
}

// Brai, 2026-09-18 (integracion Noir): challenge de un solo uso para el
// flujo "Sign-In con wallet" -- el mismo patron que MetaMask/WalletConnect
// usan para probar que el que dice ser dueño de una direccion realmente
// tiene la clave privada, sin que la plataforma jamas vea ni toque esa
// clave. Flujo completo (ver POST /api/wallets/noir-challenge y
// /api/wallets/connect-noir en server.ts):
//   1. El frontend pide un challenge nuevo -> creamos esta fila con un
//      nonce al azar y guardamos el mensaje EXACTO que se va a firmar
//      (no lo reconstruimos despues, para no depender de que el reloj o
//      el codigo no hayan cambiado un caracter entremedio).
//   2. El frontend le pide a la extension Noir que firme ESE mensaje con
//      zcash.signMessage() (firma la direccion transparente).
//   3. El backend verifica la firma con verifyMessageSignature() del
//      propio SDK de Noir (@noir-wallet/sdk) contra el mensaje que
//      guardamos -- no contra uno que mande el cliente, así nadie puede
//      mandar un mensaje distinto para intentar reusar una firma vieja.
//   4. consumeNoirChallenge() en store.ts borra la fila al verificarla
//      (o si expiró) -- de un solo uso, no se puede reproducir la misma
//      firma dos veces para "iniciar sesión" de nuevo.
// Sin esto, cualquiera podría mandar CUALQUIER dirección Zcash ajena como
// si fuera suya y quedarse con el InternalWallet (y el saldo) que ya
// estuviera asociado a esa dirección -- por eso esto no es opcional.
model NoirAuthChallenge {
  id        String   @id @default(cuid())
  nonce     String   @unique
  message   String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

enum NftWhitelistStatus {
  PENDING
  APPROVED
  REJECTED
}

// Brai, 2026-09-18: "necesito que me hagas la parte de la whitelist de los
// nft ... la gente ingrese su handle de twitter y que le haga retwitear un
// twit ... likear y seguir nuestro twitter, esto lo deje en revision, una
// revision manual en la cual yo te dire cuales son los aceptados" -- this
// is purely the submission + review-queue record. The actual checking of
// "did they really retweet/like/follow" is NOT automated anywhere in this
// codebase (no Twitter API call) -- it's 100% Brai looking at the handle
// himself and clicking approve/reject (see /api/admin/nft-whitelist* in
// server.ts). The point of the whole feature ("llamar a los KOL... les
// vamos a dar whitelist, o sea minteo gratis") is that an APPROVED,
// unclaimed entry lets a matching wallet's NEXT /api/nft/mint call skip
// payment entirely (see claimFreeNftWhitelistMint in store.ts) -- exactly
// one free mint per approved entry, never more, and it's never actually
// paid by anyone -- no ZEC moves for a free mint, it's a straight
// assignment (Brai, 2026-09-18: "no se descuenta de mi wallet el minteo...
// solo son gratis, es publicidad, un gasto administrativo").
//
// Brai, 2026-09-18 (v2): "tampoco se necesita conectar la wallet para
// agregar, solo hay que poner la wallet y el handle" -- no InternalWallet
// required at signup anymore (dropped the FK), just whatever Zcash address
// the person pastes in by hand. walletAddress is that raw string, unique so
// the same address can't queue twice. Matching it back to an actual
// connected wallet later (to know WHO to give the free mint to) is
// best-effort -- see the long comment on claimFreeNftWhitelistMint in
// store.ts for why, and which address field(s) it checks.
model NftWhitelistEntry {
  id            String             @id @default(cuid())
  walletAddress String             @unique
  // Normalizado: sin "@", en minusculas (ver normalizeTwitterHandle en
  // store.ts) -- para que "@Brai" y "brai" no puedan registrarse como dos
  // entradas distintas, y para poder buscarlo case-insensitive.
  twitterHandle String
  status        NftWhitelistStatus @default(PENDING)
  createdAt     DateTime           @default(now())
  reviewedAt    DateTime?
  // Nota libre de Brai al aprobar/rechazar (ej. "KOL, 40k followers" o
  // "no encuentro el retweet") -- puramente para su propio registro, nunca
  // mostrada al usuario.
  reviewNote    String?
  // Se llena la primera vez que el mint gratis se usa (ver
  // claimFreeNftWhitelistMint) -- queda seteado desde ese primer claim,
  // aunque sigan quedando mints gratis disponibles (ver claimedCount).
  claimedAt     DateTime?
  // Que InternalWallet.id efectivamente se llevo el mint gratis -- solo
  // informativo (no hay relacion FK a proposito, mismo patron que
  // Token.creatorWalletId mas arriba: un string suelto, no un join
  // obligatorio).
  claimedByWalletId String?
  // Brai, 2026-09-19: "las wallets de los handle que estan aprobados
  // mintean gratis solo 5 nfts" -- cuántos mints gratis ya usó esta
  // entrada. claimFreeNftWhitelistMint la incrementa en cada claim y
  // rechaza con "already_claimed" al llegar a NFT_WHITELIST_FREE_MINT_LIMIT
  // (fees.ts). Reemplaza el viejo gate "un solo claim por siempre" que
  // claimedAt solo hacía cuando era un booleano de facto.
  claimedCount  Int                @default(0)

  @@index([status])
  @@index([twitterHandle])
}

// Brai, 2026-09-18 (v10): "si te doy una lista para whitelistear aunque no
// hayan hecho el whitelist... cuando entran completan todo y ponen
// continue hasta el final al final le dice aprovedd directamente" -- a
// standing list of handles (KOLs, giveaway winners, whatever list Brai
// hands over) that skip manual review entirely. Deliberately a separate
// table from NftWhitelistEntry rather than a pre-created row: at the time
// Brai gives the list, none of these people have a wallet address on file
// yet -- they still have to go through the wizard themselves to supply
// one. submitNftWhitelistEntry checks this table by normalized handle and,
// if present, creates the entry as APPROVED instead of PENDING.
model NftWhitelistPreapproved {
  id            String   @id @default(cuid())
  // Same normalizeTwitterHandle() convention as NftWhitelistEntry.
  twitterHandle String   @unique
  // Free-text tag for which batch/list this came from (e.g. "KOL list
  // 2026-09-18") -- purely for Brai's own bookkeeping, never shown to users.
  note          String?
  createdAt     DateTime @default(now())
}
