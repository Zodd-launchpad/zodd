+        note_a2.recipient(order_a_address);
+        note_a2.value(sapling_crypto::value::NoteValue::from_raw(60_000));
+        let txid_a2 = TxId::from_bytes([0x22; 32]);
+        let wallet_note_a2 = SaplingNote::new_for_test(
+            OutputId::new(txid_a2, 0),
+            zip32::AccountId::ZERO,
+            zip32::Scope::External,
+            note_a2.build(),
+            Memo::Empty,
+            Some(incrementalmerkletree::Position::from(1)),
+        );
+        wallet.wallet_transactions.insert(
+            txid_a2,
+            WalletTransaction::new_for_test(txid_a2, ConfirmationStatus::Confirmed(11.into()))
+                .with_sapling_notes_for_test(vec![wallet_note_a2]),
+        );
+
+        let mut note_b = SaplingCryptoNoteBuilder::default();
+        note_b.recipient(order_b_address);
+        note_b.value(sapling_crypto::value::NoteValue::from_raw(100_000)); // sums equal to A's total on purpose: proves amount can't be the signal
+        let txid_b = TxId::from_bytes([0x23; 32]);
+        let wallet_note_b = SaplingNote::new_for_test(
+            OutputId::new(txid_b, 0),
+            zip32::AccountId::ZERO,
+            zip32::Scope::External,
+            note_b.build(),
+            Memo::Empty,
+            Some(incrementalmerkletree::Position::from(2)),
+        );
+        wallet.wallet_transactions.insert(
+            txid_b,
+            WalletTransaction::new_for_test(txid_b, ConfirmationStatus::Confirmed(12.into()))
+                .with_sapling_notes_for_test(vec![wallet_note_b]),
+        );
+
+        let expected_hex_a = hex::encode(order_a_address.diversifier().0);
+        let expected_hex_b = hex::encode(order_b_address.diversifier().0);
+        assert_ne!(expected_hex_a, expected_hex_b);
+
+        let summaries = wallet.note_summaries::<SaplingNote>(true);
+        let summary_for_txid = |txid: TxId| {
+            summaries
+                .iter()
+                .find(|s| s.txid == txid)
+                .unwrap_or_else(|| panic!("no note summary for {txid}"))
+        };
+
+        assert_eq!(summary_for_txid(txid_a1).diversifier_hex, expected_hex_a);
+        assert_eq!(summary_for_txid(txid_a2).diversifier_hex, expected_hex_a);
+        assert_eq!(
+            summary_for_txid(txid_a1).diversifier_hex,
+            summary_for_txid(txid_a2).diversifier_hex,
+            "two separate payments to the same order address must report the identical diversifier"
+        );
+        assert_eq!(summary_for_txid(txid_b).diversifier_hex, expected_hex_b);
+        assert_ne!(
+            summary_for_txid(txid_b).diversifier_hex,
+            summary_for_txid(txid_a1).diversifier_hex,
+            "a payment to a different order must not share A's diversifier, even with matching combined totals"
+        );
+    }
