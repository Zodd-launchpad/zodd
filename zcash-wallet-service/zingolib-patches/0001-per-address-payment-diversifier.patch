+    /// ZODD validation (2026-09-07): proves the fix for per-order shielded
+    /// payment attribution. zingo-cli's `notes` command has never exposed
+    /// which of a wallet's many diversified addresses received a given
+    /// note -- only account/scope (see the long comment history in
+    /// zcash-wallet-service/src/cli.js in the zodd repo). But
+    /// `NoteInterface::note()` returns "Decrypted note with recipient and
+    /// value" -- the diversifier is embedded in the note plaintext itself
+    /// by protocol construction (ZIP 32 / Sapling & Orchard note format),
+    /// independent of anything zingolib's KeyId bookkeeping tracks.
+    ///
+    /// This test builds two REAL sapling_crypto::Note and orchard::Note
+    /// objects (via the same mocks the rest of this file's tests use),
+    /// each addressed to a different diversified receiver generated from
+    /// the same wallet/account, inserts them as confirmed incoming notes,
+    /// and asserts that `note_summaries` (which now calls the new
+    /// `NoteInterface::diversifier_bytes` added alongside it) tells them
+    /// apart correctly -- not just "different", but each matching its own
+    /// true recipient and nobody else's. That per-address match is exactly
+    /// what a payment backend needs to treat "this address" as "this
+    /// order", with zero memo and zero amount-uniqueness requirement.
+    #[test]
+    fn note_diversifier_identifies_which_address_received_it() {
+        use pepper_sync::wallet::SaplingNote;
+
+        use crate::mocks::SaplingCryptoNoteBuilder;
+        use crate::wallet::keys::unified::ReceiverSelection;
+
+        let mut wallet = regtest_wallet(seeds::HOSPITAL_MUSEUM_SEED);
+
+        // Two distinct orders would each get their own freshly generated
+        // address in production (see generateOrderAddress in zcashReal.ts).
+        let (_, order_a_ua) = wallet
+            .generate_unified_address(ReceiverSelection::sapling_only(), zip32::AccountId::ZERO)
+            .unwrap();
+        let order_a_address = *order_a_ua.sapling().unwrap();
+
+        let (_, order_b_ua) = wallet
+            .generate_unified_address(ReceiverSelection::sapling_only(), zip32::AccountId::ZERO)
+            .unwrap();
+        let order_b_address = *order_b_ua.sapling().unwrap();
+
+        assert_ne!(
+            order_a_address.diversifier().0,
+            order_b_address.diversifier().0,
+            "test setup bug: the two generated addresses must actually differ"
+        );
+
+        let mut note_for_a = SaplingCryptoNoteBuilder::default();
+        note_for_a.recipient(order_a_address);
+        note_for_a.value(sapling_crypto::value::NoteValue::from_raw(150_000));
+        let txid_a = TxId::from_bytes([0xA; 32]);
+        let wallet_note_for_a = SaplingNote::new_for_test(
+            OutputId::new(txid_a, 0),
+            zip32::AccountId::ZERO,
+            zip32::Scope::External,
+            note_for_a.build(),
+            Memo::Empty,
+            Some(incrementalmerkletree::Position::from(0)),
+        );
+        wallet.wallet_transactions.insert(
+            txid_a,
+            WalletTransaction::new_for_test(txid_a, ConfirmationStatus::Confirmed(10.into()))
+                .with_sapling_notes_for_test(vec![wallet_note_for_a]),
+        );
+
+        let mut note_for_b = SaplingCryptoNoteBuilder::default();
+        note_for_b.recipient(order_b_address);
+        note_for_b.value(sapling_crypto::value::NoteValue::from_raw(150_000)); // same amount on purpose: proves this doesn't rely on amount uniqueness
+        let txid_b = TxId::from_bytes([0xB; 32]);
+        let wallet_note_for_b = SaplingNote::new_for_test(
+            OutputId::new(txid_b, 0),
+            zip32::AccountId::ZERO,
+            zip32::Scope::External,
+            note_for_b.build(),
+            Memo::Empty,
+            Some(incrementalmerkletree::Position::from(1)),
+        );
+        wallet.wallet_transactions.insert(
+            txid_b,
+            WalletTransaction::new_for_test(txid_b, ConfirmationStatus::Confirmed(10.into()))
+                .with_sapling_notes_for_test(vec![wallet_note_for_b]),
+        );
+
+        let expected_hex_a = hex::encode(order_a_address.diversifier().0);
+        let expected_hex_b = hex::encode(order_b_address.diversifier().0);
+
+        let summaries = wallet.note_summaries::<SaplingNote>(true);
+        let summary_for_txid = |txid: TxId| {
+            summaries
+                .iter()
+                .find(|s| s.txid == txid)
+                .unwrap_or_else(|| panic!("no note summary for {txid}"))
+        };
+
+        let found_a = summary_for_txid(txid_a);
+        let found_b = summary_for_txid(txid_b);
+
+        assert_eq!(
+            found_a.diversifier_hex, expected_hex_a,
+            "note paid to order A's address must report order A's own diversifier"
+        );
+        assert_eq!(
+            found_b.diversifier_hex, expected_hex_b,
+            "note paid to order B's address must report order B's own diversifier"
+        );
+        assert_ne!(
+            found_a.diversifier_hex, found_b.diversifier_hex,
+            "two notes paid to two different orders' addresses must never look identical"
+        );
+        // The failure mode this whole fix replaces: silently attributing
+        // B's payment to A (or vice versa) because only amount/memo were
+        // compared. Confirm explicitly that swapping is not what happened.
+        assert_ne!(found_a.diversifier_hex, expected_hex_b);
+        assert_ne!(found_b.diversifier_hex, expected_hex_a);
+    }
