+    /// Scale test: not just two addresses but five, all generated from the
+    /// same account, all sapling (the common case: many orders, one
+    /// wallet). Guards against an off-by-one or a comparison that only
+    /// happens to work for a pair. Every note carries the identical
+    /// amount, so amount can play no role in the assertions below --
+    /// diversifier is the only signal doing the attribution.
+    #[test]
+    fn note_diversifier_scales_to_many_addresses() {
+        use pepper_sync::wallet::SaplingNote;
+
+        use crate::mocks::SaplingCryptoNoteBuilder;
+        use crate::wallet::keys::unified::ReceiverSelection;
+
+        let mut wallet = regtest_wallet(seeds::HOSPITAL_MUSEUM_SEED);
+
+        const ORDER_COUNT: u8 = 5;
+        let mut addresses = Vec::new();
+        for _ in 0..ORDER_COUNT {
+            let (_, ua) = wallet
+                .generate_unified_address(ReceiverSelection::sapling_only(), zip32::AccountId::ZERO)
+                .unwrap();
+            addresses.push(*ua.sapling().unwrap());
+        }
+
+        // Every generated address must be pairwise distinct, or the whole
+        // premise of address-per-order breaks before notes even enter it.
+        for i in 0..addresses.len() {
+            for j in (i + 1)..addresses.len() {
+                assert_ne!(
+                    addresses[i].diversifier().0,
+                    addresses[j].diversifier().0,
+                    "orders {i} and {j} were generated with colliding diversifiers"
+                );
+            }
+        }
+
+        let mut txids = Vec::new();
+        for (i, address) in addresses.iter().enumerate() {
+            let mut note = SaplingCryptoNoteBuilder::default();
+            note.recipient(*address);
+            note.value(sapling_crypto::value::NoteValue::from_raw(75_000)); // identical for every order, on purpose
+            let txid = TxId::from_bytes([0x10 + i as u8; 32]);
+            let wallet_note = SaplingNote::new_for_test(
+                OutputId::new(txid, 0),
+                zip32::AccountId::ZERO,
+                zip32::Scope::External,
+                note.build(),
+                Memo::Empty,
+                Some(incrementalmerkletree::Position::from(i as u64)),
+            );
+            wallet.wallet_transactions.insert(
+                txid,
+                WalletTransaction::new_for_test(txid, ConfirmationStatus::Confirmed(10.into()))
+                    .with_sapling_notes_for_test(vec![wallet_note]),
+            );
+            txids.push(txid);
+        }
+
+        let summaries = wallet.note_summaries::<SaplingNote>(true);
+        let found_diversifiers: Vec<String> = txids
+            .iter()
+            .map(|txid| {
+                summaries
+                    .iter()
+                    .find(|s| s.txid == *txid)
+                    .unwrap_or_else(|| panic!("no note summary for {txid}"))
+                    .diversifier_hex
+                    .clone()
+            })
+            .collect();
+
+        let expected_diversifiers: Vec<String> = addresses
+            .iter()
+            .map(|address| hex::encode(address.diversifier().0))
+            .collect();
+
+        assert_eq!(
+            found_diversifiers, expected_diversifiers,
+            "each of the {ORDER_COUNT} notes must attribute to its own order's address, in order, with none swapped"
+        );
+
+        // Every reported diversifier must be unique -- no two orders
+        // sharing an attribution, which would be indistinguishable from a
+        // crossed payment in production.
+        let mut sorted = found_diversifiers.clone();
+        sorted.sort();
+        sorted.dedup();
+        assert_eq!(
+            sorted.len(),
+            ORDER_COUNT as usize,
+            "all {ORDER_COUNT} attributed diversifiers must be pairwise distinct"
+        );
+    }
